# ── Flask ────────────────────────────────────────────────────────
FLASK_CONFIG=development
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ────────────────────────────────────────────────────
# Local dev (SQLite):
# DATABASE_URL=sqlite:///./instance/dorice.db

# Supabase (get connection string from Supabase Dashboard →
#   your project → Settings → Database → Connection string → URI):
# DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Render / other Postgres host:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── School identity ────────────────────────────────────────────
