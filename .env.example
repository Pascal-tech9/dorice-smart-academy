# Dorice Smart Academy Portal - Environment Configuration
# Copy this file to .env.local and populate with your credentials.

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Safaricom Daraja — Paybill C2B (Paybill 400222)
# No STK Push is used. Parents pay via M-PESA menu: Paybill → 400222
# -----------------------------------------------------------------------------
# 'sandbox' or 'production'
MPESA_ENVIRONMENT=sandbox

# Safaricom Developer Portal credentials
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret

# Paybill passkey (provided by Safaricom after go-live approval)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Confirmed Paybill number
MPESA_SHORTCODE=400222

# Unguessable secret path segment embedded in callback URL
# Generate with: openssl rand -hex 24
MPESA_CALLBACK_SECRET_PATH=generate_an_unguessable_secret_here

# Initiator credentials for QueryTransaction (reconciliation)
MPESA_INITIATOR_NAME=testapi
MPESA_SECURITY_CREDENTIAL=encrypted_security_credential_from_daraja_portal


# -----------------------------------------------------------------------------
# Communications (Email & SMS)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Dorice Smart Academy <notifications@doricesmartacademy.sc.ke>"

# Africa's Talking SMS (Feature-flagged off by default)
SMS_ENABLED=false
AFRICASTALKING_API_KEY=your_africastalking_key
AFRICASTALKING_USERNAME=sandbox

# -----------------------------------------------------------------------------
# Phase 6: Notifications & PWA
# -----------------------------------------------------------------------------
# Publicly accessible site URL (used in email CTAs and receipt links)
NEXT_PUBLIC_SITE_URL=https://doricesmartacademy.sc.ke

# Internal secret for server-to-server notification API calls
# Generate with: openssl rand -hex 32
INTERNAL_NOTIFICATION_SECRET=generate_a_strong_random_secret_here

# Secret for the fee-reminders cron endpoint (set same value on Vercel)
# Generate with: openssl rand -hex 32
CRON_SECRET=generate_a_strong_random_secret_here

# -----------------------------------------------------------------------------
# Internationalisation
# -----------------------------------------------------------------------------
# Default locale: 'en' (English) or 'sw' (Kiswahili)
# Currently 'en' is fully translated; 'sw' is scaffolded.
NEXT_PUBLIC_DEFAULT_LOCALE=en
